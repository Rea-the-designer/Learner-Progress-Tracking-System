# 1. Object-Oriented & Encapsulation Layer

class Person:
    """Base class demonstrating Inheritance."""
    def __init__(self, name: str, age: int):
        self.name = name 
        self.age = age

class Learner(Person):
    """Class inherit from Person, Displaying complete encapsulation."""
    def __init__(self, learner_id: int, name: str, age: int, course: str):
        #This will call the class costructor initialized common attributes
        super().__init__(name, age)

        # Specific attributes for a learner
        self. learner_id = learner_id
        self. course = course
        self. marks = []

        # Encapsulation:
        
        self. _performance_status = "No Marks Registered"

# 2. Algorithmic & Recursive Layer

def recursive_sum(marks_list: list, index: int = 0) -> float:
    """
    A recursive function to calculate total marks.
    The function will call itself instead of using a loop or sum().
    This will continue until it hits the base case. 
    """
    # Base Case: When we've looked at every item, return 0
    if index == len(marks_list):
        return 0.0
    # Recursive Case: Current element + sum of the rest of the list
    return marks_list[index] + recursive_sum(marks_list, index + 1)


def calculate_average(learner: Learner) -> float:
    """This will calculate the average mark using the recursive sum function."""
    if not learner.marks:
        return 0.0
    total_score = recursive_sum(learner.marks)
    # Protect against Division by Zero errors and acts as a error handling
    return round(total_score / len(learner.marks), 2)

# 3. Controller & Core Functions Layer

def check_certificate_eligibility(avarage: float) -> bool:
    """A predicate function returning True or False."""
    return avarage >= 50.0


def display_summary_card(learner: Learner, title_prefix: str = "Learner Summary"):
    """
    A function leveraging a default argument.
    Printing block, formatted details required in the terminal

    """

    avg = calculate_average

    # Decision structure to determine performance category

    if avg < 50:
        result_category = "Fail"
    elif 50 <= avg < 75:
        result_category = "Pass"
    else:
        result_category = "Passed with distinction"

    learner.set_stattus(result_category)
    has_cert = "Yes" if check_certificate_eligibility(avg) else "No"

    print(f"\n----{title_prefix}")
    print(f"Learner ID: {learner.learner_id}")
    print(f"Name: {learner.name}")
    print(f"Age: {learner.age}")
    print(f"Course: {learner.course}")
    print(f"Average: {avg}")
    print(f"Result: {learner.get_status()}")
    print(f"Certificate: {has_cert}")

def find_learner_by_id(learners_list: list, target_id: int) -> Learner:
    """Search list for matching learner's reference"""
    # Use of a for loop
    for student in learners_list:
        if student.learner_id == target_id:
            return student
        return None

